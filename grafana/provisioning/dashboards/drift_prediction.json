      },
      "id": 4,
      "title": "Prediction Activity by Active Model Version",
      "type": "state-timeline",
      "datasource": {
        "type": "postgres",
        "uid": "PostgreSQL"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "PostgreSQL"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT created_at AS \"time\", CASE WHEN model_version = 'local_v1' THEN 0 ELSE SUBSTRING(model_version FROM '[0-9]+')::integer END AS \"Version ID\" FROM predictions WHERE $__timeFilter(created_at) ORDER BY created_at ASC",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
