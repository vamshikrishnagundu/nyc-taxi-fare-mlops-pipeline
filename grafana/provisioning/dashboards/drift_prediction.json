      },
      "id": 1,
      "title": "Numerical Feature Drift: Serving Distance Mean vs Training Baseline Mean",
      "type": "timeseries",
      "datasource": {
        "type": "postgres",
        "uid": "PostgreSQL"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "PostgreSQL"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(created_at, 5m), AVG(distance_km) AS \"Serving Distance Mean\", MAX(t.distance_mean) AS \"Baseline Distance Mean\" FROM predictions CROSS JOIN (SELECT distance_mean FROM training_stats WHERE is_promoted = true ORDER BY promoted_at DESC LIMIT 1) t WHERE $__timeFilter(created_at) GROUP BY time ORDER BY time ASC",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2
          },
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 15
              },
              {
                "color": "red",
                "value": 30
              }
            ]
          }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "title": "Categorical Feature Drift: Single-Passenger Share (%) Serving vs Baseline",
      "type": "timeseries",
      "datasource": {
        "type": "postgres",
        "uid": "PostgreSQL"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "PostgreSQL"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(created_at, 5m), SUM(CASE WHEN passenger_count = 1 THEN 1.0 ELSE 0.0 END) * 100.0 / COUNT(*) AS \"Serving % 1-Passenger\", MAX(t.passenger_1_pct) AS \"Baseline % 1-Passenger\" FROM predictions CROSS JOIN (SELECT passenger_1_pct FROM training_stats WHERE is_promoted = true ORDER BY promoted_at DESC LIMIT 1) t WHERE $__timeFilter(created_at) GROUP BY time ORDER BY time ASC",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2
          },
          "unit": "percent",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 95
              }
            ]
          }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "id": 3,
      "title": "Predictions Behavior: Mean & StdDev of Predicted Fares over Time",
      "type": "timeseries",
      "datasource": {
        "type": "postgres",
        "uid": "PostgreSQL"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "PostgreSQL"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(created_at, 5m), AVG(predicted_fare) AS \"Mean Prediction\", STDDEV(predicted_fare) AS \"StdDev Prediction\" FROM predictions WHERE $__timeFilter(created_at) GROUP BY time ORDER BY time ASC",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2
          },
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 60
              },
              {
                "color": "red",
                "value": 150
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "StdDev Prediction"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 0.01
                    },
                    {
                      "color": "green",
                      "value": 1.0
                    }
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "collapsed": false,
