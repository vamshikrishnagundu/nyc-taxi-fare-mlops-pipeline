      "id": 1,
      "title": "Ingested Rows (Total vs Valid vs Invalid) over Time",
      "type": "timeseries",
      "datasource": {
        "type": "postgres",
        "uid": "PostgreSQL"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "PostgreSQL"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT ingested_at AS \"time\", total_rows AS \"Total\", valid_rows AS \"Valid\", invalid_rows AS \"Invalid\" FROM ingestion_stats WHERE $__timeFilter(ingested_at) ORDER BY ingested_at ASC",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2
          },
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 10
              },
              {
                "color": "red",
                "value": 50
              }
            ]
          }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "title": "Percentage of Invalid Rows per Ingestion",
      "type": "timeseries",
      "datasource": {
        "type": "postgres",
        "uid": "PostgreSQL"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "PostgreSQL"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT ingested_at AS \"time\", CASE WHEN total_rows > 0 THEN (invalid_rows * 100.0 / total_rows) ELSE 0 END AS \"Invalid %\" FROM ingestion_stats WHERE $__timeFilter(ingested_at) ORDER BY ingested_at ASC",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1
          },
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 10
              },
              {
                "color": "red",
                "value": 50
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "id": 3,
      "title": "Data Quality Errors by Category",
      "type": "timeseries",
      "datasource": {
        "type": "postgres",
        "uid": "PostgreSQL"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "PostgreSQL"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT ingested_at AS \"time\", missing_values_count AS \"Completeness (Nulls)\", (negative_fare_count + wrong_passengers_count) AS \"Validity (Range Errors)\", (wrong_coordinates_count + zero_coordinates_count) AS \"Consistency (Geo Errors)\", string_in_number_count AS \"Type (Strings)\", schema_error_count AS \"Schema (Missing Columns)\" FROM ingestion_stats WHERE $__timeFilter(ingested_at) ORDER BY ingested_at ASC",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2
          },
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 10
              },
              {
                "color": "red",
                "value": 30
              }
            ]
          }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "id": 4,
      "title": "Ingestion Status History & Criticality",
      "type": "state-timeline",
      "datasource": {
        "type": "postgres",
        "uid": "PostgreSQL"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "PostgreSQL"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT ingested_at AS \"time\", CASE WHEN status = 'High' THEN 3 WHEN status = 'Medium' THEN 2 WHEN status = 'Low' THEN 1 ELSE 0 END AS \"Criticality\" FROM ingestion_stats WHERE $__timeFilter(ingested_at) ORDER BY ingested_at ASC",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 80
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "blue",
                "value": 1
              },
              {
                "color": "orange",
                "value": 2
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "None/Low",
                  "color": "green"
                },
                "1": {
                  "text": "Low",
                  "color": "blue"
                },
                "2": {
                  "text": "Medium",
                  "color": "orange"
                },
                "3": {
                  "text": "High",
                  "color": "red"
                }
              }
            }
          ]
        }
      }
    }
  ],
