# ============================================================
# Environment variables for docker-compose.
# Copy this file to `.env` and fill in the real values:
#     cp .env.example .env
# `.env` is gitignored (it holds secrets) — never commit it.
# ============================================================

# --- Data Quality Alerts channel ---------------------------------
# Used by: the ingestion DAG's Teams alerts AND Grafana's
# "Data Quality Alerts Channel" contact point (via the webhook forwarder).
# Create a Teams "When a Teams webhook request is received" (Power Automate)
# flow pointing at your Data Quality Alerts channel and paste its URL here.
REAL_TEAMS_WEBHOOK=https://your-power-automate-url/data-quality

# --- ML Alerts channel -------------------------------------------
# Used by: the training DAG's rejected-candidate alerts AND Grafana's
# "ML Alerts Channel" contact point (via the webhook forwarder).
# Build a SECOND Power Automate flow pointing at a DIFFERENT (ML Alerts)
# channel and paste its URL here.
# NOTE: if left blank, the webhook forwarder falls back to REAL_TEAMS_WEBHOOK,
# so ML alerts land in the Data Quality channel until this is set.
REAL_TEAMS_WEBHOOK_ML=
